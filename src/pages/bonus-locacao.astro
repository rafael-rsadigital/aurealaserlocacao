---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import {site, whatsappUrl} from '../data/site';

const faq = [
  {q:'O site continua no ar se eu parar de alugar?',a:'O site permanece ativo gratuitamente enquanto a parceria de locação estiver vigente. Caso a parceria seja encerrada após os 6 meses, você pode optar por mantê-lo ativo mediante uma taxa simples de hospedagem ou solicitar a migração definitiva.'},
  {q:'Posso usar meu próprio domínio .com.br?',a:'Sim. O subdomínio gratuito é a opção padrão. Se preferir um domínio exclusivo com o nome da sua clínica, fazemos a configuração técnica como upgrade opcional.'},
  {q:'A locação inclui a profissional aplicadora?',a:'Não. O foco da Áurea Laser é o fornecimento do equipamento revisado e higienizado para clínicas que já possuem profissional habilitada para a aplicação.'}
];
const organization={"@type":"Organization","@id":`${site.domain}/#organization`,name:site.name,url:site.domain,sameAs:site.socialLinks.map((social:any)=>social.url)};
const offer={"@type":"Offer","@id":`${site.domain}/bonus-locacao/#offer`,name:'Site One-Page e otimização do Google Meu Negócio',description:'Estrutura digital para atrair pacientes e preencher a agenda nas locações recorrentes do Ácrus HTM.',seller:{"@id":`${site.domain}/#organization`},url:`${site.domain}/bonus-locacao/`};
const schema={"@context":"https://schema.org","@graph":[organization,offer]} as Record<string, unknown>;
---
<BaseLayout title="Bônus de Locação: Site One-Page + Google Meu Negócio | Áurea Laser" description="Ganhe uma Landing Page profissional e a otimização do Google Meu Negócio para atrair pacientes e preencher a agenda da sua clínica nas locações recorrentes." schema={schema} breadcrumbs={[{label:'Bônus de locação'}]}>
  <section class="bonus-hero section"><div class="container bonus-hero__inner"><div><span class="eyebrow">Bônus exclusivo · atração de pacientes</span><h1>Transforme sua presença digital em uma <em>agenda mais cheia</em></h1><p class="bonus-lead">Nas locações recorrentes, sua clínica ganha uma Landing Page profissional e a otimização do Google Meu Negócio — duas ferramentas para ser encontrada, gerar contatos e converter o interesse em agendamentos para o seu Laser Day.</p><div class="bonus-hero__actions"><a class="btn btn-primary" href={whatsappUrl('Olá! Quero consultar a disponibilidade de uma data e conhecer o bônus de Site One-Page e Google Meu Negócio.')}>Quero atrair mais pacientes</a><a class="btn btn-ghost" href="#bonus">Ver o que está incluso</a></div></div><div class="bonus-hero__visual card"><div class="bonus-visual-stat"><strong>+ presença local</strong><span>Site que explica sua oferta e facilita o contato</span></div><div class="bonus-visual-stat"><strong>+ visibilidade</strong><span>Google Meu Negócio otimizado para buscas da região</span></div><div class="bonus-visual-stat"><strong>+ conversão</strong><span>Mensagem direta para transformar interesse em agenda</span></div></div></div></section>
  <section id="bonus" class="section bonus-offer-section"><div class="container"><span class="eyebrow">O potencial do bônus</span><h2>Não é só um site. É uma estrutura para <em>ser encontrado e gerar agendamentos</em>.</h2><p class="bonus-copy">A clínica pode ter um equipamento excelente e ainda perder oportunidades se o paciente não encontrar informações claras, confiança e um caminho rápido para chamar no WhatsApp. Por isso, a parceria entrega uma base digital pensada para apresentar seu Laser Day e transformar buscas em conversas.</p><div class="grid cards-2 bonus-cards"><div class="bonus-card card"><span class="bonus-number">Bônus 1 · R$ 1.500 GRÁTIS</span><h3>Landing Page que apresenta sua clínica e facilita a decisão</h3><p>Uma página One-Page profissional, elegante e rápida, com uma comunicação clara da sua oferta de depilação a laser, provas de confiança, chamada para o Laser Day e botão de agendamento direto no WhatsApp da sua clínica. Hospedada em subdomínio gratuito, com opção de upgrade para domínio próprio.</p><ul class="bonus-benefits"><li>Apresenta o serviço com clareza</li><li>Funciona muito bem no celular</li><li>Conduz o visitante até o contato</li></ul></div><div class="bonus-card card"><span class="bonus-number">Bônus 2 · R$ 497 GRÁTIS</span><h3>Google Meu Negócio para aumentar sua descoberta local</h3><p>Otimizamos o perfil da sua clínica para melhorar sua presença nas buscas e no mapa do Google quando alguém procurar por “depilação a laser perto de mim” na sua região.</p><ul class="bonus-benefits"><li>Mais presença nas buscas locais</li><li>Informações organizadas e confiáveis</li><li>Mais oportunidades de receber contatos</li></ul></div></div></div></section>
  <section class="section bonus-potential-section"><div class="container bonus-potential-grid"><div><span class="eyebrow">Da busca ao Laser Day</span><h2>Um caminho simples para o paciente <em>chegar até sua agenda</em></h2></div><div class="grid cards-3"><div class="card"><span class="numbers">01</span><h3>Ser encontrado</h3><p>O Google Meu Negócio ajuda sua clínica a aparecer quando existe uma busca local.</p></div><div class="card"><span class="numbers">02</span><h3>Entender sua oferta</h3><p>A Landing Page reúne benefícios, estrutura e informações do seu atendimento.</p></div><div class="card"><span class="numbers">03</span><h3>Agendar</h3><p>O WhatsApp encurta o caminho entre o interesse e a conversa sobre o próximo Laser Day.</p></div></div></div></section>
  <section class="section bonus-partnership"><div class="container bonus-partnership__grid"><div><span class="eyebrow">Como ter acesso</span><h2>Uma parceria pensada para <em>crescer com recorrência</em></h2></div><div class="prose"><p>Para receber toda essa estrutura digital com custo zero de desenvolvimento e manutenção, estabelecemos uma fidelidade simbólica de 6 meses de parceria, com frequência mínima de 1 locação por mês.</p><div class="bonus-safety"><strong>Transparência:</strong> não há multas contratuais abusivas sobre o maquinário. Caso precise interromper antes do prazo, haverá apenas uma taxa administrativa e operacional única de desativação digital para cobrir os custos da página.</div></div></div></section>
  <section class="section"><div class="container"><span class="eyebrow">A estrutura começa com a locação</span><h2>Escolha o período do seu próximo <em>Laser Day</em></h2><p class="bonus-copy">A tecnologia Ácrus HTM Triple Wave entra como parte da operação, com locação de 6, 9 ou 12 horas, logística regional na Baixada Santista, montagem, preparação técnica e entrega conforme as condições combinadas.</p><div class="grid cards-3 bonus-plan-cards"><div class="card"><b>6 horas</b><p>Para uma agenda concentrada e objetiva.</p></div><div class="card featured"><b>9 horas</b><p>Mais tempo para aproveitar o potencial do Laser Day.</p></div><div class="card"><b>12 horas</b><p>Para operações com agenda ampliada.</p></div></div></div></section>
  <section class="section bonus-faq-section"><div class="container" style="max-width:850px"><span class="eyebrow">Perguntas frequentes</span><h2>Dúvidas sobre o bônus e a <em>parceria</em></h2><FAQ items={faq}/></div></section><CTA label="Quero garantir máquina + bônus" message="Olá! Quero consultar a disponibilidade do Ácrus HTM e entender como garantir o Site One-Page e o Google Meu Negócio na locação recorrente." />
</BaseLayout>
