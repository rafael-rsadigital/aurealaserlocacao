---
import BaseLayout from '../../layouts/BaseLayout.astro'; import {whatsappUrl} from '../../data/site';
const posts=[
['locacao-ou-compra','Locação de laser ou compra: qual modelo faz sentido para uma clínica?','Compare os caminhos de planejamento sem reduzir a decisão a uma promessa financeira.'],
['o-que-e-laser-day','O que é Laser Day e como funciona?','Entenda as etapas para organizar uma operação de depilação a laser na clínica.'],
['triple-wave','Ácrus HTM Triple Wave: como funciona a tecnologia?','Conheça os comprimentos de onda e o papel da preparação técnica.'],
['alexandrite-diodo-ndyag','Alexandrite, Diodo e Nd:YAG: entenda as diferenças','Um guia introdutório para profissionais de clínicas de estética.'],
['soprano-ice-ou-acrus-htm','Soprano Ice ou Ácrus HTM: custo-benefício para locação de laser','Compare tecnologia, modos de aplicação e custo de locação para planejar seu Laser Day.'],
['alternativa-ao-hakon-para-laser-day','Hakon ou Ácrus HTM: compare tecnologias e custo de locação para Laser Day','Veja diferenças técnicas e critérios práticos para comparar as duas plataformas na locação.']
];
---
<BaseLayout title="Blog | Áurea Laser Locação" description="Conteúdos para clínicas de estética sobre locação de laser, Laser Day, tecnologia Ácrus HTM e comparação de equipamentos." breadcrumbs={[{label:'Blog'}]}><section class="section"><div class="container"><span class="eyebrow">Conteúdo para clínicas</span><h1>Decisões melhores para sua <em>operação de laser.</em></h1><p style="max-width:650px">Guias práticos para planejar locação, agenda, Laser Day e tecnologia para clínicas de estética.</p><div class="grid cards-3" style="margin-top:3rem">{posts.map(([slug,title,desc])=><article class="card"><span class="eyebrow">Guia Áurea</span><h2 style="font-size:1.5rem">{title}</h2><p>{desc}</p><a href={`/blog/${slug}/`}>Ler artigo →</a></article>)}</div></div></section></BaseLayout>
