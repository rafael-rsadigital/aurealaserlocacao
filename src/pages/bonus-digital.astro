---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import {site, whatsappUrl} from '../data/site';

const faq = [
  {q:'O site continua no ar se eu parar de alugar?',a:'O site permanece ativo gratuitamente enquanto a parceria de locação estiver vigente. Caso a parceria seja encerrada após os 6 meses, você pode optar por mantê-lo ativo mediante uma taxa simples de hospedagem ou solicitar a migração definitiva.'},
  {q:'Posso usar meu próprio domínio .com.br?',a:'Sim. O subdomínio gratuito é a opção padrão. Se preferir um domínio exclusivo com o nome da sua clínica, fazemos a configuração técnica como upgrade opcional.'},
  {q:'A locação inclui a profissional aplicadora?',a:'Não. O foco da Áurea Laser é o fornecimento do equipamento revisado e higienizado para clínicas que já possuem profissional habilitada para a aplicação.'}
];
const organization={"@type":"Organization","@id":`${site.domain}/#organization`,name:site.name,url:site.domain,sameAs:site.socialLinks.map((social:any)=>social.url)};
const offer={"@type":"Offer","@id":`${site.domain}/bonus-digital/#offer`,name:'Site One-Page e otimização do Google Meu Negócio',description:'Bônus digital para locações recorrentes do Ácrus HTM.',seller:{"@id":`${site.domain}/#organization`},url:`${site.domain}/bonus-digital/`};
const schema={"@context":"https://schema.org","@graph":[organization,offer]} as Record<string, unknown>;
---
<BaseLayout title="Bônus Digital para Locações Recorrentes | Áurea Laser" description="Ganhe Site One-Page e otimização do Google Meu Negócio nas locações recorrentes do Ácrus HTM na Baixada Santista." schema={schema} breadcrumbs={[{label:'Bônus digital'}]}>
  <section class="bonus-hero section">
    <div class="container bonus-hero__inner">
      <div>
        <span class="eyebrow">Bônus exclusivo · parceria recorrente</span>
        <h1>Locação de Ácrus HTM para Depilação a Laser na <em>Baixada Santista</em></h1>
        <p class="bonus-lead">Alugue a tecnologia Triple Wave para o seu Laser Day e ganhe toda a estrutura digital para lotar a agenda da sua clínica.</p>
        <a class="btn btn-primary" href={whatsappUrl('Olá! Quero consultar a disponibilidade de uma data e conhecer o bônus digital da locação recorrente.')}>Consultar disponibilidade de data</a>
      </div>
      <div class="bonus-hero__visual card"><img src={site.equipmentImage} alt="Equipamento Ácrus HTM Triple Wave para locação" width="627" height="482" /><span>Triple Wave · pronto para sua agenda</span></div>
    </div>
  </section>

  <section class="section bonus-wave-section"><div class="container"><span class="eyebrow">O diferencial do equipamento</span><h2>Uma plataforma, <em>três comprimentos de onda</em> para resultados imbatíveis</h2><p class="bonus-copy">O Ácrus HTM combina Alexandrite 755 nm, Diodo 808 nm e Nd:YAG 1064 nm em uma única aplicação. Garanta uma plataforma versátil para diferentes fototipos de pele, com o conforto do resfriamento da ponteira. O equipamento perfeito para ampliar sua oferta e fidelizar pacientes.</p><div class="grid cards-3 bonus-wave-cards"><div class="card"><b>755 nm</b><h3>Alexandrite</h3><p>Uma das tecnologias integradas à plataforma Triple Wave.</p></div><div class="card"><b>808 nm</b><h3>Diodo</h3><p>Mais uma faixa de atuação em um único equipamento profissional.</p></div><div class="card"><b>1064 nm</b><h3>Nd:YAG</h3><p>Versatilidade para protocolos definidos por profissional habilitado.</p></div></div></div></section>

  <section class="section bonus-offer-section"><div class="container"><span class="eyebrow">Super bônus exclusivo</span><h2>Feche a locação e ganhe uma <em>estrutura digital avaliada em R$ 1.997</em></h2><p class="bonus-copy">Nós não entregamos apenas a máquina. Nós entregamos estrutura para atrair pacientes. Ao se tornar parceiro de locação recorrente, nossa equipe cria e otimiza ferramentas para ajudar a lotar a agenda do seu Laser Day.</p><div class="grid cards-2 bonus-cards"><div class="bonus-card card"><span class="bonus-number">Bônus 1</span><h3>Site One-Page (Landing Page) — <em>R$ 1.500 GRÁTIS</em></h3><p>Uma página profissional, elegante e rápida, projetada para conversão e agendamentos diretos no WhatsApp da sua clínica. Hospedada em subdomínio gratuito, com opção de upgrade para domínio próprio.</p></div><div class="bonus-card card"><span class="bonus-number">Bônus 2</span><h3>Otimização do Google Meu Negócio — <em>R$ 497 GRÁTIS</em></h3><p>Colocamos sua clínica no mapa do Google e otimizamos seu perfil para aumentar as chances de aparecer nas buscas da sua região por depilação a laser.</p></div></div></div></section>

  <section class="section bonus-partnership"><div class="container bonus-partnership__grid"><div><span class="eyebrow">Transparência na parceria</span><h2>Como funciona a nossa <em>Parceria de Sucesso</em>?</h2></div><div class="prose"><p>Para receber toda essa estrutura digital com custo zero de desenvolvimento e manutenção, estabelecemos uma fidelidade simbólica de 6 meses de parceria, com frequência mínima de 1 locação por mês.</p><div class="bonus-safety"><strong>Importante:</strong> não há multas contratuais abusivas sobre o maquinário. Caso precise interromper antes do prazo, haverá apenas uma taxa administrativa e operacional única de desativação digital para cobrir os custos da página.</div></div></div></section>

  <section class="section"><div class="container"><span class="eyebrow">Planos de locação flexíveis</span><h2>Períodos de <em>6h, 8h ou 12h</em> para a sua agenda</h2><p class="bonus-copy">Condição especial para a primeira locação com valores a partir de R$ 500. Nossa proposta inclui logística regional na Baixada Santista, montagem, preparação técnica e entrega pontual para você focar no atendimento.</p><div class="grid cards-3 bonus-plan-cards"><div class="card"><b>6 horas</b><p>Para uma agenda concentrada e objetiva.</p></div><div class="card featured"><b>8 horas</b><p>Mais tempo para aproveitar o Laser Day.</p></div><div class="card"><b>12 horas</b><p>Para operações com agenda ampliada.</p></div></div></div></section>

  <section class="section bonus-faq-section"><div class="container" style="max-width:850px"><span class="eyebrow">Perguntas frequentes</span><h2>Dúvidas sobre a locação e os <em>bônus</em></h2><FAQ items={faq}/></div></section>
  <CTA label="Garantir máquina + bônus pelo WhatsApp" message="Olá! Quero consultar a disponibilidade do Ácrus HTM e conhecer as condições para garantir o site e o Google Meu Negócio na locação recorrente." />
</BaseLayout>
