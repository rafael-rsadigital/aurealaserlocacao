---
import { site, whatsappUrl } from '../data/site';
const { city } = Astro.props;
const message = `Olá! Gostaria de consultar as condições de locação do Ácrus HTM${city ? ` em ${city}` : ''} para minha clínica.`;
---
<section class="section pricing-section">
  <div class="container">
    <span class="eyebrow">Locação sob consulta</span>
    <h2>Vamos encontrar a melhor opção para sua clínica?</h2>
    <p class="pricing-lead">Consulte a disponibilidade do equipamento, informe a data e o período desejados e receba as condições diretamente pelo WhatsApp.</p>
    <a class="btn btn-primary" href={whatsappUrl(message)}>Consultar condições pelo WhatsApp</a>
    <p class="pricing-note">Valores e logística informados conforme período, localização e disponibilidade.</p>
  </div>
</section>